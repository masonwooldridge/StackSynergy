{
  "expo": {
    "name": "CardChasm",
    "slug": "cardchasm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardchasm.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.cardchasm.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow CardChasm to photograph Magic cards for review.",
          "photosPermission": "Allow CardChasm to choose card photos for review.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "scheme": "cardchasm"
  }
}
