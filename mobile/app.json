{
  "expo": {
    "name": "StackSynergy",
    "slug": "stacksynergy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardchasm.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.cardchasm.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow StackSynergy to photograph Magic cards for review.",
          "photosPermission": "Allow StackSynergy to choose card photos for review.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "scheme": [
      "stacksynergy",
      "cardchasm"
    ],
    "icon": "./assets/icon.png",
    "githubUrl": "https://github.com/masonwooldridge/StackSynergy"
  }
}
